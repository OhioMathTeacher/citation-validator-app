# Copy this file to `.env` and fill in the values. `.env` is gitignored
# (see .gitignore line 10) and must never be committed — this repository
# is public.
#
#   cp .env.example .env
#
# Then open `.env` in your editor and paste the key after the `=`.
# No quotes, no spaces around the `=`, no trailing whitespace.
#
# Get a Gemini key at: https://aistudio.google.com/apikey
# The free tier allows 1M tokens/day, which is roughly one full pass of
# the AI benchmark suite.

GEMINI_API_KEY=

# Only needed to reproduce the Claude Sonnet comparison in Table 4.
# Leave blank to run the Gemini-only passes.
ANTHROPIC_API_KEY=
