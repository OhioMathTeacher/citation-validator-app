# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Secrets — never commit
.env
.env.*
*.key
*_secret*
api_keys.txt

# OS / editor
.DS_Store
*.swp

# Upstream third-party data, fetched on demand and never redistributed
.cache/

# Third-party datasets: fetched on demand, never redistributed (see datasets/README.md)
datasets/citeaudit-*/[!R]*
datasets/compound-deception-ansari/[!R]*

# Other people's papers. extract_citations_from_arxiv.py downloads arXiv source
# bundles so their bibliographies can be harvested for the test corpus. The
# bundles are working material, not ours to redistribute: arXiv's default licence
# lets arXiv distribute a paper, not third parties. Keep them locally, keep them
# out of the release archive.
test_citations/[0-9][0-9][0-9][0-9].[0-9]*/
test_citations/[0-9][0-9][0-9][0-9].[0-9]*.tar.gz

!.env.example

# Saved UI exports and editor backups under results/. These are not primary
# evidence -- results/experiments/ is -- and they carried withheld citation
# text past the redaction in scripts/strip_restricted_results.py, because they
# are neither .json in the expected shape nor labelled with a dataset.
results/**/citation-report-*
results/**/*.bak-*
